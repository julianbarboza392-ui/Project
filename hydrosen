            card = tk.Frame(self.content_frame, bg="white", bd=1, relief="solid")
            card.pack(fill="x", padx=20, pady=8)

            tk.Label(card, text=name, font=("Arial", 13, "bold"), bg="white", fg="#0a4a7a").pack(anchor="w", padx=15, pady=(10, 2))
