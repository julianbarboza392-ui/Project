    def current_flood_rank(self):
        dams = get_dams()
        if self.flood_target:
            dams = [d for d in dams if d[0] == self.flood_target]
        if not dams:
            return 0
        return max(STATUS_RANK[d[5]] for d in dams)

    def refresh_flood_header(self):
        if hasattr(self, "flood_info_label") and self.flood_info_label.winfo_exists():
            self.flood_info_label.config(text=self.build_info_text())

    def build_info_text(self):
        dams = get_dams()
        if self.flood_target:
            dams = [d for d in dams if d[0] == self.flood_target]
        lines = []
        for name, loc, river, dist, level, status, updated in dams:
            lines.append("%s: %.2f m  |  %s  |  updated %s" % (name, level, status, updated))
        return "\n".join(lines)

    def show_dam_flood(self, dam_name):
        self.current_view = "flood_dam"
        self.flood_target = dam_name
        self.clear_content()

        title = "Flooded Areas in Dagupan - " + (dam_name if dam_name else "San Roque + Ambuklao (Combined)")
        self.section_title(title, "Updates automatically as the dam water level changes")

        tk.Button(self.content_frame, text="< BACK TO DAM STATUS", font=("Arial", 10, "bold"),
                  bg="#eaf6ff", fg="#0a4a7a", relief="flat", padx=10, pady=4, cursor="hand2",
                  command=self.show_dam).pack(anchor="w", padx=20, pady=(10, 0))

        self.flood_info_label = tk.Label(self.content_frame, text=self.build_info_text(), font=("Arial", 10),
                                         bg="#f7fbff", justify="left", anchor="w", padx=15, pady=10, bd=1, relief="solid")
        self.flood_info_label.pack(fill="x", padx=20, pady=10)

        rank = self.current_flood_rank()
        self.flood_rank_shown = rank
        status_name = [k for k, v in STATUS_RANK.items() if v == rank][0]

        tk.Label(self.content_frame, text="Overall alert: " + status_name, font=("Arial", 12, "bold"),
                 bg=status_color(status_name), fg="white", padx=12, pady=4).pack(anchor="w", padx=20, pady=(0, 10))

        groups = flood_areas_for_rank(rank)
        if not groups:
            tk.Label(self.content_frame, text="No flooding expected in Dagupan at the current dam level.",
                     font=("Arial", 11), bg="white", fg="#2ecc71").pack(anchor="w", padx=20, pady=10)
        else:
            for gtitle, areas in groups:
                f = tk.Frame(self.content_frame, bg="white")
                f.pack(fill="x", padx=20, pady=10)
                tk.Label(f, text=gtitle, font=("Arial", 11, "bold"), bg="white", fg="#0a4a7a").pack(anchor="w")
                for a in areas:
                    tk.Label(f, text=" - " + a, font=("Arial", 10), bg="white").pack(anchor="w", padx=10)

        tk.Label(self.content_frame,
                 text="Note: San Roque releases water down the Agno River toward Dagupan; Ambuklao is upstream "
                      "and its releases flow toward San Roque. Always follow CDRRMO and barangay advisories.",
                 font=("Arial", 9), bg="white", fg="gray", wraplength=700, justify="left").pack(anchor="w", padx=20, pady=15)

