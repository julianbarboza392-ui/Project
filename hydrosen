import tkinter as tk
import sqlite3
import random
from datetime import datetime

DB_NAME = "hydrosentinel.db"
REFRESH_MS = 5000 

DAM_CONFIG = {
    "San Roque Dam": {
        "monitoring": 278.0, "moderate": 280.0, "high": 285.0, "critical": 290.0,
        "min": 270.0, "max": 292.0, "step": 0.35,
    },
    "Ambuklao Dam": {
        "monitoring": 750.0, "moderate": 752.0, "high": 754.0, "critical": 756.0,
        "min": 740.0, "max": 758.0, "step": 0.25,
    },
}

STATUS_RANK = {"NORMAL": 0, "MONITORING": 1, "MODERATE RISK": 2, "HIGH RISK": 3, "CRITICAL": 4}

FLOOD_WATCH = ["Pantal", "Pogo Chico / Pogo Grande", "Mayombo, Tapuac", "Lasip Chico & Lasip Grande"]
FLOOD_MODERATE = ["Barangay I, II, III, IV", "Herrero-Perez, Poblacion Oeste", "Caranglaan, Bolosan, Salisay"]
FLOOD_HIGH = ["Malued - Sitio Fisheries, Calarin", "Lasip Chico & Lasip Grande", "Bacayao Norte / Sur",
              "Pantal, Pogo Chico/Grande", "Mayombo, Tapuac"]
FLOOD_ISLAND = ["Lomboy", "Salapingao", "Pugaro, Carael, Calmay"]


def compute_status(dam_name, level):
    cfg = DAM_CONFIG[dam_name]
    if level >= cfg["critical"]:
        return "CRITICAL"
    if level >= cfg["high"]:
        return "HIGH RISK"
    if level >= cfg["moderate"]:
        return "MODERATE RISK"
    if level >= cfg["monitoring"]:
        return "MONITORING"
    return "NORMAL"


def status_color(status):
    if status in ("CRITICAL", "HIGH RISK"):
        return "#e74c3c"
    if status in ("MODERATE RISK", "MONITORING"):
        return "#f39c12"
    return "#2ecc71"


def flood_areas_for_rank(rank):
    """Return list of (group title, [areas]) for a given severity rank."""
    if rank <= 0:
        return []
    if rank == 1:
        return [("WATCH LIST - Low-lying areas (possible ankle to knee-deep water)", FLOOD_WATCH)]
    if rank == 2:
        return [("MODERATE FLOODED (Knee deep)", FLOOD_MODERATE)]
    if rank == 3:
        return [("HIGHLY FLOODED (Chest to waist)", FLOOD_HIGH),
                ("MODERATE FLOODED (Knee deep)", FLOOD_MODERATE)]
    return [("HIGHLY FLOODED (Chest to waist)", FLOOD_HIGH),
            ("MODERATE FLOODED (Knee deep)", FLOOD_MODERATE),
            ("ISLAND BARANGAYS - Isolation Risk", FLOOD_ISLAND)]


def init_db():
    conn = sqlite3.connect(DB_NAME)
    c = conn.cursor()

    c.execute("PRAGMA table_info(dams)")
    cols = [row[1] for row in c.fetchall()]
    if cols and "updated" not in cols:
        c.execute("DROP TABLE dams")

    c.execute('''CREATE TABLE IF NOT EXISTS dams
                 (id INTEGER PRIMARY KEY AUTOINCREMENT,
                  name TEXT UNIQUE,
                  location TEXT,
                  river TEXT,
                  distance TEXT,
                  water_level REAL,
                  status TEXT,
                  updated TEXT)''')
    

    c.execute("SELECT COUNT(*) FROM dams")
    if c.fetchone()[0] == 0:
        now = datetime.now().strftime("%Y-%m-%d %I:%M:%S %p")
        dams_data = [
            ("San Roque Dam", "San Manuel / San Nicolas, Pangasinan", "Agno River", "~45 km NE",
             280.8, compute_status("San Roque Dam", 280.8), now),
            ("Ambuklao Dam", "Bokod, Benguet", "Agno River (Upstream)", "~90 km NE",
             748.5, compute_status("Ambuklao Dam", 748.5), now),
        ]
        c.executemany("INSERT INTO dams VALUES (NULL,?,?,?,?,?,?,?)", dams_data)

    conn.commit()
    conn.close()


def fetch_live_level(dam_name, current_level):
    """
    Returns the newest water level (in meters) for a dam.

    Currently SIMULATED (small random movement). To use real data, replace the
    body of this function with a call to your data source (e.g. PAGASA dam data)
    and return the level as a float.
    """
    cfg = DAM_CONFIG[dam_name]
    new_level = current_level + random.uniform(-cfg["step"], cfg["step"])
    return round(max(cfg["min"], min(cfg["max"], new_level)), 2)


def update_all_dams():
    conn = sqlite3.connect(DB_NAME)
    c = conn.cursor()
    c.execute("SELECT name, water_level FROM dams")
    rows = c.fetchall()
    now = datetime.now().strftime("%Y-%m-%d %I:%M:%S %p")
    for name, level in rows:
        new_level = fetch_live_level(name, level)
        c.execute("UPDATE dams SET water_level=?, status=?, updated=? WHERE name=?",
                  (new_level, compute_status(name, new_level), now, name))
    conn.commit()
    conn.close()


def get_dams():
    conn = sqlite3.connect(DB_NAME)
    c = conn.cursor()
    c.execute("SELECT name, location, river, distance, water_level, status, updated FROM dams ORDER BY id")
    rows = c.fetchall()
    conn.close()
    return rows


