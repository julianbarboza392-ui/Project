        self.current_view = "flood_dam"
        self.flood_target = dam_name
        self.clear_content()

        self.section_title("Flooded Areas in Dagupan - " + dam_name,
                           "Updates automatically as the dam water level changes")

        tk.Button(self.content_frame, text="< BACK TO DAM STATUS", font=("Arial", 10, "bold"),
                  bg="#eaf6ff", fg="#0a4a7a", relief="flat", padx=10, pady=4, cursor="hand2",
                  command=self.show_dam).pack(anchor="w", padx=20, pady=(10, 0))

        self.flood_info_label = tk.Label(self.content_frame, text=self.build_info_text(),
                                         font=("Arial", 10), bg="#f7fbff", justify="left", anchor="w",
                                         padx=15, pady=10, bd=1, relief="solid")
        self.flood_info_label.pack(fill="x", padx=20, pady=10)

        rank = self.current_flood_rank()
        self.flood_rank_shown = rank
        status_name = STATUS_ORDER[rank]

        tk.Label(self.content_frame, text="Alert level: " + status_name, font=("Arial", 12, "bold"),
                 bg=status_color(status_name), fg="white", padx=12, pady=4).pack(anchor="w", padx=20,
                                                                                  pady=(0, 10))

        groups = FLOOD_BY_DAM[dam_name].get(rank, [])
        if not groups:
            msg = "No flooding expected in Dagupan from %s at the current water level." % dam_name
            tk.Label(self.content_frame, text=msg, font=("Arial", 11), bg="white",
                     fg="#2ecc71").pack(anchor="w", padx=20, pady=10)
        else:
            for gtitle, areas in groups:
                f = tk.Frame(self.content_frame, bg="white")
                f.pack(fill="x", padx=20, pady=10)
                tk.Label(f, text=gtitle, font=("Arial", 11, "bold"), bg="white",
                         fg="#0a4a7a").pack(anchor="w")
