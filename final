def compute_status(dam_name, level):
    cfg = DAM_CONFIG[dam_name]
    if level >= cfg["critical"]:
        return "CRITICAL"
    if level >= cfg["high"]:
        return "HIGH RISK"
    if level >= cfg["moderate"]:
        return "MODERATE RISK"
    if level >= cfg["monitoring"]:
        return "MONITORING"
    return "NORMAL"


def status_color(status):
    if status in ("CRITICAL", "HIGH RISK"):
        return "#e74c3c"
    if status in ("MODERATE RISK", "MONITORING"):
        return "#f39c12"
    return "#2ecc71"


def status_band(dam_name, status):
    """(low, high) water-level range that produces the given status."""
    cfg = DAM_CONFIG[dam_name]
    bands = {
        "NORMAL": (cfg["min"], cfg["monitoring"]),
        "MONITORING": (cfg["monitoring"], cfg["moderate"]),
        "MODERATE RISK": (cfg["moderate"], cfg["high"]),
        "HIGH RISK": (cfg["high"], cfg["critical"]),
        "CRITICAL": (cfg["critical"], cfg["max"]),
    }
    return bands[status]

def init_db():
    conn = sqlite3.connect(DB_NAME)
    c = conn.cursor()

    c.execute("PRAGMA table_info(dams)")
    cols = [row[1] for row in c.fetchall()]
    if cols and "updated" not in cols:
        c.execute("DROP TABLE dams")

    c.execute('''CREATE TABLE IF NOT EXISTS dams
                 (id INTEGER PRIMARY KEY AUTOINCREMENT,
                  name TEXT UNIQUE,
                  location TEXT,
                  river TEXT,
                  distance TEXT,
                  water_level REAL,
                  status TEXT,
                  updated TEXT)''')

    c.execute("SELECT COUNT(*) FROM dams")
    if c.fetchone()[0] == 0:
        now = datetime.now().strftime("%Y-%m-%d %I:%M:%S %p")
        dams_data = [
            ("San Roque Dam", "San Manuel / San Nicolas, Pangasinan", "Agno River", "~45 km NE",
             280.8, compute_status("San Roque Dam", 280.8), now),
            ("Ambuklao Dam", "Bokod, Benguet", "Agno River (Upstream)", "~90 km NE",
             748.5, compute_status("Ambuklao Dam", 748.5), now),
        ]
        c.executemany("INSERT INTO dams VALUES (NULL,?,?,?,?,?,?,?)", dams_data)

    conn.commit()
    conn.close()


_TARGETS = {}


BALANCED_STATUSES = ["NORMAL", "MODERATE RISK", "HIGH RISK"]


def _pick_new_target(dam_name, avoid_status=None):
    choices = [s for s in BALANCED_STATUSES if s != avoid_status]
    status = random.choice(choices)
    low, high = status_band(dam_name, status)
    return random.uniform(low + 0.05, high - 0.05)


def fetch_live_level(dam_name, current_level):
    """
    Returns the newest water level (in meters) for a dam.

    Currently SIMULATED. To use real data, replace the body of this function
    with a call to your data source (e.g. PAGASA dam data) and return a float.
    """
    cfg = DAM_CONFIG[dam_name]
    target = _TARGETS.get(dam_name)
    if target is None or abs(target - current_level) < cfg["step"]:
        target = _pick_new_target(dam_name, compute_status(dam_name, current_level))
        _TARGETS[dam_name] = target

    move = random.uniform(0.4, 1.0) * cfg["step"]
    new_level = current_level + (move if target > current_level else -move)
    new_level += random.uniform(-0.05, 0.05)
    return round(max(cfg["min"], min(cfg["max"], new_level)), 2)


def update_all_dams():
    conn = sqlite3.connect(DB_NAME)
    c = conn.cursor()
    c.execute("SELECT name, water_level FROM dams")
    rows = c.fetchall()
    now = datetime.now().strftime("%Y-%m-%d %I:%M:%S %p")
    for name, level in rows:
        new_level = fetch_live_level(name, level)
        c.execute("UPDATE dams SET water_level=?, status=?, updated=? WHERE name=?",
                  (new_level, compute_status(name, new_level), now, name))
    conn.commit()
    conn.close()


def get_dams():
    conn = sqlite3.connect(DB_NAME)
    c = conn.cursor()
    c.execute("SELECT name, location, river, distance, water_level, status, updated FROM dams ORDER BY id")
    rows = c.fetchall()
    conn.close()
    return rows


def get_dam(dam_name):
    for d in get_dams():
        if d[0] == dam_name:
            return d
    return None


