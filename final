    def update_clock(self):
        now = datetime.now().strftime("%Y-%m-%d  %I:%M:%S %p")
        self.time_label.config(text=now)
        self.root.after(1000, self.update_clock)

    def clear_content(self):
        for w in self.content_frame.winfo_children():
            w.destroy()
        self.dam_widgets = {}
        self.flood_info_label = None
        self.canvas.yview_moveto(0)

    def section_title(self, title, subtitle=""):
        tk.Label(self.content_frame, text=title, font=("Arial", 18, "bold"), bg="white",
                 fg="#0a4a7a").pack(anchor="w", padx=20, pady=(20, 5))
        if subtitle:
            tk.Label(self.content_frame, text=subtitle, font=("Arial", 11), bg="white",
                     fg="gray").pack(anchor="w", padx=20)

    def bind_click(self, widget, command):
        """Make a widget (and all its children except buttons) clickable."""
        if not isinstance(widget, tk.Button):
            widget.bind("<Button-1>", lambda e: command())
            widget.config(cursor="hand2")
        for child in widget.winfo_children():
            self.bind_click(child, command)

    def check_alerts(self, dams):
        """Show a notification popup when a dam newly reaches (or rises to) HIGH RISK / CRITICAL."""
        for name, loc, river, dist, level, status, updated in dams:
            rank = STATUS_RANK[status]
            prev = self.last_rank.get(name, 0)
            if rank >= ALERT_RANK and rank > prev:
                self.show_alert_popup(name, level, status, rank)
            self.last_rank[name] = rank
            if rank < ALERT_RANK:
                self.close_alert_popup(name)

    def close_alert_popup(self, dam_name):
        win = self.alert_windows.pop(dam_name, None)
        if win is not None and win.winfo_exists():
            win.destroy()

    def show_alert_popup(self, dam_name, level, status, rank):
        self.close_alert_popup(dam_name)

        win = tk.Toplevel(self.root)
        win.title("FLOOD ALERT - " + dam_name)
        win.configure(bg="white")
        win.resizable(False, False)
        win.attributes("-topmost", True)
        self.alert_windows[dam_name] = win
        win.protocol("WM_DELETE_WINDOW", lambda: self.close_alert_popup(dam_name))

        top = tk.Frame(win, bg=status_color(status))
        top.pack(fill="x")
        tk.Label(top, text="FLOOD ALERT: %s" % status, font=("Arial", 16, "bold"), bg=status_color(status),
                 fg="white", padx=20, pady=10).pack()

        body = tk.Frame(win, bg="white")
        body.pack(fill="both", padx=20, pady=10)
        tk.Label(body, text="%s is now at %s" % (dam_name, status), font=("Arial", 12, "bold"),
                 bg="white", fg="#0a4a7a").pack(anchor="w")
        tk.Label(body, text="Water level: %.2f m" % level, font=("Arial", 11), bg="white").pack(anchor="w")
        tk.Label(body, text="Time: " + datetime.now().strftime("%I:%M:%S %p"), font=("Arial", 9),
                 bg="white", fg="gray").pack(anchor="w", pady=(0, 8))

        groups = FLOOD_BY_DAM[dam_name].get(rank, [])
        if groups:
            tk.Label(body, text="Areas expected to be affected:", font=("Arial", 10, "bold"),
                     bg="white").pack(anchor="w")
            for gtitle, areas in groups:
                tk.Label(body, text=gtitle, font=("Arial", 9, "bold"), bg="white",
                         fg="#c0392b").pack(anchor="w", pady=(4, 0))
                for a in areas:
                    tk.Label(body, text="  - " + a, font=("Arial", 9), bg="white").pack(anchor="w")

        tk.Label(body, text="Prepare your Go-Bag and follow CDRRMO / barangay advisories.",
                 font=("Arial", 9, "italic"), bg="white", fg="gray", wraplength=360,
                 justify="left").pack(anchor="w", pady=(10, 0))

        btns = tk.Frame(win, bg="white")
        btns.pack(pady=(5, 15))
        tk.Button(btns, text="OK", font=("Arial", 10, "bold"), bg="#95a5a6", fg="white",
                  relief="flat", padx=24, pady=5, cursor="hand2",
                  command=lambda: self.close_alert_popup(dam_name)).pack()

        win.update_idletasks()
        x = self.root.winfo_x() + self.root.winfo_width() - win.winfo_width() - 30
        y = self.root.winfo_y() + 90 + (40 if dam_name != "San Roque Dam" else 0)
        win.geometry("+%d+%d" % (max(x, 0), max(y, 0)))

        try:
            self.root.bell()      
        except tk.TclError:
            pass

    def realtime_tick(self):
        update_all_dams()
        dams = get_dams()
        self.check_alerts(dams)

        if self.current_view == "dam":
            for name, loc, river, dist, level, status, updated in dams:
                w = self.dam_widgets.get(name)
                if w:
                    w["level"].config(text="Water Level: %.2f m" % level)
                    w["status"].config(text="STATUS: " + status, bg=status_color(status))
                    w["updated"].config(text="Last update: " + updated)

        elif self.current_view == "flood_dam":
            rank = self.current_flood_rank()
            if rank != self.flood_rank_shown:
                self.show_dam_flood(self.flood_target)
            else:
                self.refresh_flood_header()

        self.root.after(REFRESH_MS, self.realtime_tick)

