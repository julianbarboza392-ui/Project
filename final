                    "level has the strongest effect on the city.")
        else:
            note = ("Ambuklao is further upstream; its releases flow into San Roque first, so the effect "
                    "on Dagupan is delayed and smaller at the same alert level.")
        note += " Always follow CDRRMO and barangay advisories."
        tk.Label(self.content_frame, text="Note: " + note, font=("Arial", 9), bg="white", fg="gray",
                 wraplength=700, justify="left").pack(anchor="w", padx=20, pady=15)

