                      bg="#0a4a7a", fg="white", activebackground="#1480d6", relief="flat",
                      padx=12, pady=6, cursor="hand2",
                      command=lambda n=name: self.show_dam_flood(n)).pack(anchor="w", padx=15, pady=(0, 12))

            self.bind_click(card, lambda n=name: self.show_dam_flood(n))

            self.dam_widgets[name] = {"level": lvl, "status": st, "updated": upd}

    def current_flood_rank(self):
        d = get_dam(self.flood_target)
        return STATUS_RANK[d[5]] if d else 0

    def build_info_text(self):
        d = get_dam(self.flood_target)
        if not d:
            return ""
        name, loc, river, dist, level, status, updated = d
        return "%s (%s)\nWater level: %.2f m  |  %s\nUpdated %s" % (name, loc, level, status, updated)

    def refresh_flood_header(self):
        if self.flood_info_label is not None and self.flood_info_label.winfo_exists():
            self.flood_info_label.config(text=self.build_info_text())

