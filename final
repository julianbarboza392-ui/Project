        self.section_title("Dams Monitored for Dagupan")

        for name, loc, river, dist, level, status, updated in get_dams():
            card = tk.Frame(self.content_frame, bg="white", bd=1, relief="solid")
            card.pack(fill="x", padx=20, pady=8)

            tk.Label(card, text=name, font=("Arial", 13, "bold"), bg="white",
                     fg="#0a4a7a").pack(anchor="w", padx=15, pady=(10, 2))
            tk.Label(card, text="Location: " + loc, font=("Arial", 9), bg="white",
                     fg="gray").pack(anchor="w", padx=15)
            tk.Label(card, text="River: " + river, font=("Arial", 9), bg="white").pack(anchor="w", padx=15)
            tk.Label(card, text="Distance from Dagupan: " + dist, font=("Arial", 9),
                     bg="white").pack(anchor="w", padx=15)
            lvl = tk.Label(card, text="Water Level: %.2f m" % level, font=("Arial", 10), bg="white")
            lvl.pack(anchor="w", padx=15, pady=(5, 0))
            upd = tk.Label(card, text="Last update: " + updated, font=("Arial", 8), bg="white", fg="gray")
            upd.pack(anchor="w", padx=15)
