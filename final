    def show_evac(self):
        self.current_view = "evac"
        self.clear_content()
        self.section_title("Nearby Evacuation Center - Dagupan City")

        picker = tk.Frame(self.content_frame, bg="white")
        picker.pack(fill="x", padx=20, pady=15)
        tk.Label(picker, text="Barangay:", font=("Arial", 11, "bold"), bg="white",
                 fg="#0a4a7a").pack(side="left")

        self.brgy_var = tk.StringVar()
        self.brgy_combo = ttk.Combobox(picker, textvariable=self.brgy_var, width=38,
                                       font=("Arial", 11), values=ALL_BARANGAYS)
        self.brgy_combo.pack(side="left", padx=10)
        self.brgy_combo.bind("<<ComboboxSelected>>", lambda e: self.on_brgy_selected())
        self.brgy_combo.bind("<KeyRelease>", self.on_brgy_typed)
        self.brgy_combo.bind("<Return>", lambda e: self.on_brgy_enter())
        self.brgy_combo.focus_set()

        self.evac_results = tk.Frame(self.content_frame, bg="white")
        self.evac_results.pack(fill="x", padx=20, pady=5)
        tk.Label(self.evac_results, text="Select a barangay to see its nearest evacuation center.",
                 font=("Arial", 10), bg="white", fg="gray").pack(anchor="w")

        tk.Label(self.content_frame, text="All Accredited Evacuation Centers",
                 font=("Arial", 13, "bold"), bg="white", fg="#0a4a7a").pack(anchor="w", padx=20,
                                                                              pady=(25, 5))
        for name, (loc, tag) in EVAC_CENTERS.items():
            self.evac_row(self.content_frame, name, loc, tag)

    def match_barangays(self, text):
        text = text.strip().lower()
        if not text:
            return list(ALL_BARANGAYS)
        starts = [b for b in ALL_BARANGAYS if b.lower().startswith(text)]
        contains = [b for b in ALL_BARANGAYS if text in b.lower() and b not in starts]
        return starts + contains

    def on_brgy_typed(self, event):
        if event.keysym in ("Return", "Up", "Down", "Left", "Right", "Tab", "Escape",
                            "Shift_L", "Shift_R", "Control_L", "Control_R"):
            return
        matches = self.match_barangays(self.brgy_var.get())
        self.brgy_combo["values"] = matches if matches else ALL_BARANGAYS
        if not self.brgy_var.get().strip():
            self.render_evac_message("Select a barangay to see its nearest evacuation center.")
        elif len(matches) == 1:
            self.render_evac_result(matches[0])
        elif not matches:
            self.render_evac_message("No barangay found. Check the spelling or pick from the list.",
                                     error=True)
        else:
            self.render_evac_message("%d matches - keep typing or pick one from the list." % len(matches))

    def on_brgy_enter(self):
        matches = self.match_barangays(self.brgy_var.get())
        if matches:
            self.brgy_var.set(matches[0])
            self.brgy_combo.icursor("end")
            self.render_evac_result(matches[0])
        else:
            self.render_evac_message("No barangay found. Check the spelling or pick from the list.",
                                     error=True)

    def on_brgy_selected(self):
        self.brgy_combo["values"] = ALL_BARANGAYS
        brgy = self.brgy_var.get()
        if brgy in BARANGAY_EVAC:
            self.render_evac_result(brgy)

    def render_evac_message(self, text, error=False):
        for w in self.evac_results.winfo_children():
            w.destroy()
        tk.Label(self.evac_results, text=text, font=("Arial", 10), bg="white",
                 fg="#c0392b" if error else "gray").pack(anchor="w")

    def render_evac_result(self, brgy):
        for w in self.evac_results.winfo_children():
            w.destroy()
        center = BARANGAY_EVAC[brgy]
        loc, tag = EVAC_CENTERS[center]
        tk.Label(self.evac_results, text="Nearest evacuation center for %s:" % brgy,
                 font=("Arial", 12, "bold"), bg="white", fg="#0a4a7a").pack(anchor="w", pady=(0, 5))
        self.evac_row(self.evac_results, center, loc, tag, highlight="NEAREST")
        tk.Label(self.evac_results,
                 text="Note: Based on approximate location. Follow your barangay / CDRRMO instructions "
                      "on which center is open.",
                 font=("Arial", 9), bg="white", fg="gray", wraplength=700,
                 justify="left").pack(anchor="w", pady=(5, 0))

    def evac_row(self, parent, name, loc, tag, highlight=None):
        bg = "#e8f8ee" if highlight else "white"
        row = tk.Frame(parent, bg=bg, bd=1, relief="solid")
        row.pack(fill="x", padx=20 if parent is self.content_frame else 0, pady=5)
        left = tk.Frame(row, bg=bg)
        left.pack(side="left", padx=10, pady=10)
        title = name if not highlight else "%s  -  %s" % (highlight, name)
        tk.Label(left, text=title, font=("Arial", 11, "bold"), bg=bg, anchor="w").pack(anchor="w")
        tk.Label(left, text=loc, font=("Arial", 9), bg=bg, fg="gray", anchor="w").pack(anchor="w")
        tk.Label(row, text=tag, font=("Arial", 8, "bold"), bg="#e1f0ff", fg="#0a4a7a", padx=8,
                 pady=3).pack(side="right", padx=15)

